# One-shot acceptance suite image: runs pytest against the compose network.
FROM python:3.12-slim

ARG TARGETARCH
ARG DOCKER_VERSION=27.4.1

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

# Static Docker CLI so restart-persistence tests can restart the API service
# through the read-only mounted host socket.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
         arm64) darch=aarch64 ;; \
         amd64) darch=x86_64 ;; \
         *) echo "unsupported arch: $arch" && exit 1 ;; \
       esac \
    && curl -fsSL \
       "https://download.docker.com/linux/static/stable/${darch}/docker-${DOCKER_VERSION}.tgz" \
       -o /tmp/docker.tgz \
    && tar -xzf /tmp/docker.tgz -C /tmp \
    && mv /tmp/docker/docker /usr/local/bin/docker \
    && chmod +x /usr/local/bin/docker \
    && rm -rf /tmp/docker /tmp/docker.tgz /var/lib/apt/lists/*

# Copy BOTH manifests: requirements-verify.txt starts with
# "-r requirements.txt", so the primary list must be present or pip fails
# with "Could not open requirements file: requirements.txt".
COPY requirements.txt requirements-verify.txt ./
RUN pip install --no-cache-dir -r requirements-verify.txt

COPY tests ./tests
COPY pytest.ini ./pytest.ini
COPY scripts ./scripts

CMD ["pytest", "-v", "--tb=short"]
